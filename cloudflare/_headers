# ---- Caching ---------------------------------------------------------------
# HTML: always revalidate quickly so content updates show within minutes.
# ("/" gets its Cache-Control in its rule above so each pattern appears once.)
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Non-fingerprinted static files (current assets/ and images/): one day.
# Their filenames do not change when content changes, so do not make them immutable.
/assets/*
  Cache-Control: public, max-age=86400
/images/*
  Cache-Control: public, max-age=86400

# Fingerprinted assets only (filename contains a content hash): one year, immutable.
# NOTE: nothing in the repo is fingerprinted yet; this top-level directory is a convention
# reserved for future build output. Do not put non-hashed files under it.
/immutable/*
  Cache-Control: public, max-age=31536000, immutable
